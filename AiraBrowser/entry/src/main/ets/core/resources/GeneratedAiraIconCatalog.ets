  static hasLegacyResource(iconId: AiraRenderableIconId): boolean {
    switch (iconId) {
      case "desktopCard.navigationArrow":
      case "desktopCard.shortcut.bookmarks":
      case "desktopCard.shortcut.downloads":
      case "desktopCard.shortcut.history":
      case "desktopCard.shortcut.settings":
        return true;
      default:
        return false;
    }
  }

  static resolveLegacyResource(iconId: AiraRenderableIconId): Resource | undefined {
    switch (iconId) {
      case "desktopCard.navigationArrow":
        return $r("app.media.app_widget_navigation_arrow");
      case "desktopCard.shortcut.bookmarks":
        return $r("app.media.app_widget_shortcut_bookmarks");
      case "desktopCard.shortcut.downloads":
        return $r("app.media.app_widget_shortcut_downloads");
      case "desktopCard.shortcut.history":
        return $r("app.media.app_widget_shortcut_history");
      case "desktopCard.shortcut.settings":
        return $r("app.media.app_widget_shortcut_settings");
      default:
        return undefined;
    }
  }
